#!/bin/sh
# macOS Surge Fake IPv6 LAN RIO helper.
# Requires Surge with ipv6-vif = always and a root LaunchDaemon.
# This reference targets Surge 6.8+ Fake IPv6 addresses.
set -eu

FAKE_PREFIX="2001:2:0:6152::"
FAKE_PLEN="64"
CONF="/usr/local/etc/surge-fake-rtadvd.conf"
INTERVAL=30
RTADVD_PID=""
RTADVD_IF=""

# Required: set the physical LAN interface that should send the RIO (for
# example, en0). The helper refuses to run until this placeholder is replaced.
LAN_IF="${LAN_IF:-__LAN_INTERFACE__}"

# Optional stable ULA address for a router-side static-route fallback. Replace
# with an unused address from your LAN ULA /64, or leave the placeholder as-is
# to disable this optional alias.
LAN_ULA_ADDR="${LAN_ULA_ADDR:-__LAN_ULA_ADDR__}"
LAN_ULA_PLEN="${LAN_ULA_PLEN:-64}"

find_vif() {
  /sbin/route -n get -inet 198.18.0.2 2>/dev/null |
    /usr/bin/awk '/interface:/ && $2 ~ /^utun[0-9]+$/ {print $2; exit}'
}

ensure_lan_ula() {
  IF="$1"
  case "$LAN_ULA_ADDR" in
    ""|__LAN_ULA_ADDR__) return 0 ;;
  esac
  if /sbin/ifconfig "$IF" | /usr/bin/awk -v addr="$LAN_ULA_ADDR" '
    $1 == "inet6" && $2 == addr {found=1}
    END {exit !found}
  '; then
    return 0
  fi
  /sbin/ifconfig "$IF" inet6 "${LAN_ULA_ADDR}/${LAN_ULA_PLEN}" alias
}

fix_fake_route() {
  VIF="$1"
  /sbin/route -n delete -inet6 "${FAKE_PREFIX}/${FAKE_PLEN}" >/dev/null 2>&1 || true
  /sbin/route -n add -inet6 "${FAKE_PREFIX}/${FAKE_PLEN}" -interface "$VIF" >/dev/null 2>&1 || true
}

write_conf() {
  IF="$1"
  /bin/cat > "$CONF" <<EOF
${IF}:\
	:rltime#0:mininterval#3:maxinterval#10:\
		:addr="2001:db8:6152::":prefixlen#64:pinfoflags#0:vltime#0:pltime#0:\
	:rtprefix="${FAKE_PREFIX}":rtplen#${FAKE_PLEN}:rtflags="":rtltime#180:
EOF
}

start_rtadvd() {
  IF="$1"
  if [ -n "$RTADVD_PID" ] && /bin/kill -0 "$RTADVD_PID" 2>/dev/null && [ "$RTADVD_IF" = "$IF" ]; then
    return 0
  fi
  [ -z "$RTADVD_PID" ] || /bin/kill "$RTADVD_PID" 2>/dev/null || true
  /usr/bin/pkill rtadvd 2>/dev/null || true
  write_conf "$IF"
  /usr/sbin/rtadvd -d -s -c "$CONF" "$IF" >/dev/null 2>&1 &
  RTADVD_PID=$!
  RTADVD_IF="$IF"
}

cleanup() {
  [ -z "$RTADVD_PID" ] || /bin/kill "$RTADVD_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

case "$LAN_IF" in
  ""|__LAN_INTERFACE__)
    echo "Set LAN_IF to the physical LAN interface before starting this helper." >&2
    exit 2
    ;;
esac

/usr/bin/pkill rtadvd 2>/dev/null || true

while :; do
  IF="$LAN_IF"

  if [ -n "$IF" ]; then
    ensure_lan_ula "$IF"
    /usr/sbin/sysctl -w net.inet6.ip6.forwarding=1 >/dev/null
    start_rtadvd "$IF"

    VIF=$(find_vif)
    if [ -n "$VIF" ]; then
      fix_fake_route "$VIF"
      /bin/sleep 2
      fix_fake_route "$VIF"
    fi
  fi

  /bin/sleep "$INTERVAL"
done
